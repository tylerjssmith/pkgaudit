# R
^\.Rhistory$
^\.Rprofile$
^pkgaudit\.Rproj$
^\.Rproj\.user$

# dev directories
^data-raw$
^dev$
^docs$
^tools$

# dev infrastructure
^\.claude$
^\.github$
^renv$
^renv\.lock$

# documentation
# Knitting a vignette leaves its HTML beside the source. That copy is stale the
# moment the source changes, and must not ship as though it were built from the
# code in this tarball; R CMD build renders the real one into inst/doc.
^[^/]+\.html$
^vignettes/.*\.html$
^README\.Rmd$
^_pkgdown\.yml$
^pkgdown$
^references\.bib$

# license
^LICENSE\.md$

# scrap
\.DS_Store$








